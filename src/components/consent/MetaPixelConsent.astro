---
// Einwilligungs-Banner fuer das ShortSelect-eigene Meta-Pixel (Werbemessung).
//
// Rechtlicher Rahmen: § 25 Abs. 1 TDDDG und Art. 6 Abs. 1 lit. a DSGVO. Das Pixel
// wird ausschliesslich nach ausdruecklicher Zustimmung geladen. Ohne Entscheidung
// oder nach Ablehnung wird kein Skript von Meta nachgeladen und kein Cookie gesetzt.
// Die Entscheidung liegt im localStorage (ss_consent, Version 1) und gilt fuer
// www.shortselect.com. Die App (app.shortselect.com) hat ihren eigenen Banner mit
// derselben Kategorie "Marketing".
//
// Wiedereroeffnen: jedes Element mit data-consent-open, etwa der Link im Footer und
// der Button in der Datenschutzerklaerung (Abschnitt 4).
//
// ABHAENGIGKEIT Datenschutzerklaerung: Abschnitt 4, 11, 13 und 14 beschreiben genau
// dieses Pixel (Cookies _fbp und _fbc, Empfaenger Meta Platforms Ireland). Wer die
// Pixel-ID, die Cookies oder die Einwilligungsbindung aendert, zieht den Text mit.
const PIXEL_ID = '2024996624821852';
---

<div id="ss-consent" class="ssc" hidden role="dialog" aria-labelledby="ssc-title" aria-describedby="ssc-text">
  <div class="ssc-box">
    <p id="ssc-title" class="ssc-title">Cookies</p>
    <p id="ssc-text" class="ssc-text">
      Wir würden gern messen, ob unsere Anzeigen bei Facebook und Instagram zu Registrierungen führen. Dafür lädt das Meta-Pixel erst, wenn du zustimmst. Es setzt die Cookies <code>_fbp</code> und <code>_fbc</code>, Empfänger ist Meta Platforms Ireland. Ohne Zustimmung passiert nichts. Widerrufen kannst du jederzeit unter <a href="/datenschutz/">Datenschutz</a>.
    </p>
    <div class="ssc-actions">
      <button type="button" class="ssc-btn ssc-btn-ghost" data-consent-choice="deny">Ablehnen</button>
      <button type="button" class="ssc-btn ssc-btn-primary" data-consent-choice="grant">Zustimmen</button>
    </div>
  </div>
</div>

<style is:global>
  .ssc { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 9000; display: flex; justify-content: center; }
  .ssc[hidden] { display: none; }
  .ssc-box { max-width: 560px; width: 100%; background: #ffffff; color: #0a0a0e; border: 1px solid #e4e4e7; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.14); padding: 18px 20px; font-family: 'Inter', system-ui, sans-serif; }
  .ssc-title { margin: 0 0 6px; font-family: 'Poppins', system-ui, sans-serif; font-weight: 700; font-size: 16px; line-height: 1.3; }
  .ssc-text { margin: 0; font-size: 13.5px; line-height: 1.55; color: #525252; }
  .ssc-text a { color: #ef4444; text-decoration: underline; }
  .ssc-text code { font-size: 12.5px; background: #f4f4f5; padding: 1px 5px; border-radius: 4px; }
  .ssc-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px; flex-wrap: wrap; }
  .ssc-btn { border-radius: 100px; padding: 10px 18px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; border: 1px solid #e4e4e7; }
  .ssc-btn-ghost { background: #ffffff; color: #0a0a0e; }
  .ssc-btn-ghost:hover { background: #f4f4f5; }
  .ssc-btn-primary { background: #ef4444; color: #ffffff; border-color: #ef4444; }
  .ssc-btn-primary:hover { background: #dc2626; }
  .ssc-btn:focus-visible { outline: 3px solid rgba(239,68,68,0.35); outline-offset: 2px; }
  @media (max-width: 480px) { .ssc { left: 10px; right: 10px; bottom: 10px; } .ssc-actions { flex-direction: column-reverse; } .ssc-btn { width: 100%; } }
</style>

<script is:inline define:vars={{ PIXEL_ID }}>
  (function () {
    var KEY = 'ss_consent';
    var VERSION = 1;
    var banner = document.getElementById('ss-consent');
    if (!banner) return;

    function read() {
      try {
        var raw = window.localStorage.getItem(KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || parsed.v !== VERSION) return null;
        return parsed;
      } catch (e) { return null; }
    }
    function write(meta) {
      try { window.localStorage.setItem(KEY, JSON.stringify({ v: VERSION, meta: !!meta, ts: new Date().toISOString() })); } catch (e) {}
    }

    var loaded = false;
    function loadPixel() {
      if (loaded || !PIXEL_ID) return;
      loaded = true;
      /* Offizieller Meta-Pixel-Loader, unveraendert, nur nach Einwilligung ausgefuehrt. */
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', PIXEL_ID);
      window.fbq('track', 'PageView');
    }

    function show() { banner.hidden = false; var first = banner.querySelector('[data-consent-choice="grant"]'); if (first) first.focus({ preventScroll: true }); }
    function hide() { banner.hidden = true; }

    banner.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-consent-choice]');
      if (!btn) return;
      var grant = btn.getAttribute('data-consent-choice') === 'grant';
      write(grant);
      hide();
      if (grant) loadPixel();
    });

    document.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-consent-open]');
      if (!opener) return;
      e.preventDefault();
      show();
    });

    window.ssConsent = { get: read, reopen: show };

    var state = read();
    if (state === null) {
      show();
    } else if (state.meta === true) {
      loadPixel();
    }
  })();
</script>
