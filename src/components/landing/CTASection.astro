---
import { TRIAL_DAYS } from '../../lib/billing-constants';
import { TRIAL_CTA_LABEL, signupUrl } from '../../lib/cta';
import TrialCtaNote from '../ui/TrialCtaNote.astro';
---

<section id="cta-section" class="brand-close">
  <div>
    <h2>Bereit, Stellen doppelt so schnell zu <em>besetzen?</em></h2>
    <p>Testen Sie {TRIAL_DAYS} Tage kostenlos, wie ShortSelect Ihre Pipeline füllt.</p>
    <div class="intro-actions">
      <a class="paper-button" href={signupUrl('cta_section')}>{TRIAL_CTA_LABEL} <span aria-hidden="true">→</span></a>
      <a class="paper-button paper-button--light" href="/demo/">Demo vereinbaren</a>
      <TrialCtaNote tone="dark" />
    </div>
    <ul class="close-benefits">
      <li>Alle Funktionen inklusive</li><li>Setup in 5 Minuten</li><li>Jederzeit kündbar</li>
    </ul>
  </div>
</section>
