---
import FamilyHero from '../components/editorial/FamilyHero.astro';
import FeatureSection from '../components/editorial/FeatureSection.astro';
import MarketingLayout from './MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

interface Props {
  title: string;
  description: string;
  badgeText: string;
  badgeIcon: string;
  headline: string;
  highlightedWord: string;
  headlineSuffix: string;
  subline: string;
  secondaryCta?: string;
  secondaryCtaHref?: string;
  painTitle: string;
  painSubline?: string;
  painHighlight?: string;
  painPoints: { title: string; description: string; iconPath: string }[];
  solutionBadge?: string;
  solutionTitle: string;
  solutionHighlight?: string;
  solutions: { title: string; subtitle: string; description: string; iconPath: string }[];
  extraSectionHtml?: string;
}

const {
  title,
  description,
  badgeText,
  badgeIcon,
  headline,
  highlightedWord,
  headlineSuffix,
  subline,
  secondaryCta,
  secondaryCtaHref = '#features',
  painTitle,
  painSubline,
  painHighlight,
  painPoints,
  solutionBadge,
  solutionTitle,
  solutionHighlight,
  solutions,
} = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": "Lösungen", "item": "https://www.shortselect.com/fuer/" },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
};
---

<MarketingLayout title={title} description={description} jsonLd={breadcrumbSchema}>
  <FamilyHero
    id="loesung-hero" kind="brief" label={badgeText}
    parent={{ label: 'Lösungen', href: '/fuer/' }} subline={subline}
    sheetTitle={`${solutionTitle} ${solutionHighlight || ''}`.trim()}
    rows={solutions.slice(0, 3).map((solution, i) => ({ ...solution, href: `#loesung-${i + 1}` }))}
    trial secondary={secondaryCta ? { label: secondaryCta, href: secondaryCtaHref } : undefined}
  >
    {headline}{' '}<em>{highlightedWord}</em>{/^[.,!?]/.test(headlineSuffix) ? headlineSuffix : ` ${headlineSuffix}`}
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={badgeIcon} /></svg>
  </FamilyHero>

  <FeatureSection
    id="loesung-painpoints" variant="notes" title={painTitle} accent={painHighlight}
    intro={painSubline} items={painPoints}
  />
  <section id="features" class="family-section">
    <div class="family-section__inner">
      <header class="family-section__head">
        {solutionBadge && <p class="family-section__label">{solutionBadge}</p>}
        <h2>{solutionTitle}{solutionHighlight && <> <span>{solutionHighlight}</span></>}</h2>
      </header>
      <div class="family-section__grid">
        {solutions.map((solution, i) => (
          <article id={`loesung-${i + 1}`} class="family-feature">
            <div class="family-feature__symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={solution.iconPath}/></svg>
            </div>
            <div class="family-solution__title">{solution.title}</div>
            <h3>{solution.subtitle}</h3>
            <p>{solution.description}</p>
            <span class="family-solution__ready"><span aria-hidden="true">✓</span> Sofort einsatzbereit</span>
          </article>
        ))}
      </div>
    </div>
  </section>
  <slot />
  <CTASection />
</MarketingLayout>
