---
import { TRIAL_CTA_LABEL } from '../lib/cta';
import TrialCtaNote from '../components/ui/TrialCtaNote.astro';
import MarketingLayout from './MarketingLayout.astro';
import FeatureTable from '../components/vergleich/FeatureTable.astro';
import CTASection from '../components/landing/CTASection.astro';

interface ComparisonRow {
  feature: string;
  ssStatus: 'check' | 'warn' | 'x';
  ssLabel: string;
  compStatus: 'check' | 'warn' | 'x';
  compLabel: string;
}

interface FaqItem {
  question: string;
  answer: string;
  answerHtml?: string;
}

interface Props {
  title: string;
  description: string;
  competitorName: string;
  heroSubline: string;
  heroBadge: string;
  ssDescription: string;
  ssHighlights: string[];
  compDescription: string;
  compHighlights: string[];
  comparisonData: ComparisonRow[];
  whenCompBetter: { title: string; intro: string; items: string[] };
  whenSSBetter: { title: string; intro: string; items: string[] };
  faqs?: FaqItem[];
}

const {
  title,
  description,
  competitorName,
  heroSubline,
  heroBadge,
  ssDescription,
  ssHighlights,
  compDescription,
  compHighlights,
  comparisonData,
  whenCompBetter,
  whenSSBetter,
  faqs,
} = Astro.props;

const migrationSteps = [
  { step: "1", title: "Account erstellen", desc: "Kostenlos in unter 2 Minuten registrieren." },
  { step: "2", title: "Daten importieren", desc: "Kandidaten und Jobs per CSV oder API übertragen." },
  { step: "3", title: "Team einladen", desc: "Recruiter und Hiring Manager hinzufügen." },
  { step: "4", title: "Loslegen", desc: "Sofort mit KI-gestütztem Recruiting starten." },
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": "Vergleich", "item": "https://www.shortselect.com/vergleich/" },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
};

const hasFaqs = !!faqs && faqs.length > 0;

const faqSchema = hasFaqs
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    }
  : null;

const jsonLd = faqSchema
  ? [webPageSchema, breadcrumbSchema, faqSchema]
  : [webPageSchema, breadcrumbSchema];
---

<MarketingLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="duel-hero" id="vergleich-hero">
    <div class="duel-width">
      <nav aria-label="Breadcrumb" class="duel-crumbs">
        <a href="/">Start</a><span aria-hidden="true">/</span><a href="/vergleich/">ATS-Vergleich</a>
        <span aria-hidden="true">/</span><span aria-current="page">ShortSelect vs. {competitorName}</span>
      </nav>
      <div class="duel-grid">
        <div class="duel-copy">
          <p class="duel-label">{heroBadge}</p>
          <h1>ShortSelect vs. <span>{competitorName}</span></h1>
          <p class="duel-lead">{heroSubline}</p>
          <div class="duel-actions">
            <div>
              <a class="duel-button" href="https://app.shortselect.com/signup">{TRIAL_CTA_LABEL} <span aria-hidden="true">→</span></a>
              <TrialCtaNote class="mt-3" />
            </div>
            <a class="table-jump" href="#vergleich-table">Zum Feature-Vergleich <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="duel-profiles" id="vergleich-summary">
          {[
            { name: 'ShortSelect', description: ssDescription, highlights: ssHighlights },
            { name: competitorName, description: compDescription, highlights: compHighlights },
          ].map(({name, description, highlights}, index) => (
            <article class:list={['duel-profile', {'duel-brand': index === 0}]}>
              <header>
                {index === 0 ? <img src="/icon.svg" alt="" width="36" height="36"/> : <span class="duel-initial" aria-hidden="true">{name[0]}</span>}
                <div><h2>{name}</h2><p>{description}</p></div>
              </header>
              <ul>{highlights.map(item => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="vergleich-table" class="duel-section">
    <div class="duel-width">
      <div class="duel-heading">
        <h2>Feature-Vergleich <span>im Detail.</span></h2>
        <p>Ein ehrlicher Blick auf die Unterschiede.</p>
      </div>
      <FeatureTable
        label={`Feature-Vergleich von ShortSelect und ${competitorName}`}
        columns={['ShortSelect', competitorName]}
        rows={comparisonData.map(row => ({
          feature: row.feature,
          values: [
            {status: row.ssStatus, label: row.ssLabel},
            {status: row.compStatus, label: row.compLabel},
          ],
        }))}
      />
    </div>
  </section>

  <section id="vergleich-when" class="duel-section duel-decision">
    <div class="duel-width decision-grid">
      {[
        { label: 'Faire Einschätzung', data: whenCompBetter },
        { label: 'Empfehlung', data: whenSSBetter },
      ].map(({label, data}) => (
        <article>
          <p class="duel-label">{label}</p>
          <h2>{data.title}</h2>
          <p>{data.intro}</p>
          <ul>{data.items.map(item => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <slot />

  <section id="vergleich-migration" class="duel-section">
    <div class="duel-width">
      <div class="duel-heading">
        <p class="duel-label">Einfacher Wechsel</p>
        <h2>In 15 Minuten <span>umgezogen.</span></h2>
        <p>Der Wechsel von {competitorName} zu ShortSelect ist einfacher als gedacht.</p>
      </div>
      <ol class="migration-track">
        {migrationSteps.map(step => (
          <li>
            <span class="step" aria-hidden="true">{step.step}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
      <div class="migration-action">
        <a class="duel-button" href="https://app.shortselect.com/signup">{TRIAL_CTA_LABEL} <span aria-hidden="true">→</span></a>
        <TrialCtaNote class="mt-3" />
      </div>
    </div>
  </section>

  {hasFaqs && (
    <section class="duel-section duel-faq" id="vergleich-faq">
      <div class="duel-width faq-grid">
        <div class="duel-heading">
          <h2>Häufige Fragen zu <span>ShortSelect vs. {competitorName}</span></h2>
          <p>Antworten auf die wichtigsten Fragen zur Entscheidung zwischen ShortSelect und {competitorName}.</p>
        </div>
        <div class="duel-questions">
          {faqs.map(faq => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answerHtml ? <Fragment set:html={faq.answerHtml} /> : faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</MarketingLayout>

<style>
  .duel-hero { background: radial-gradient(ellipse at 80% 42%, #ffe7db, transparent 55%), #fffbf6; padding: 1.8rem 0 clamp(3.7rem, 6.4vw, 6rem); }
  .duel-width { margin-inline: auto; width: min(72rem, calc(100% - 3rem)); }
  .duel-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem; font-size: .8rem; color: #625850; }
  .duel-crumbs a:hover, .table-jump:hover { color: #a72c25; text-decoration: underline; }
  .duel-grid { display: grid; align-items: center; grid-template-columns: minmax(0,1.03fr) minmax(0,1fr); gap: clamp(2.5rem, 6vw, 6rem); padding-top: clamp(2rem, 4.5vw, 4.5rem); }
  .duel-label { display: inline-flex; align-items: center; gap: .5rem; font-size: .85rem; font-weight: 750; color: #912f22; }
  .duel-label::before { content: ''; width: 1.8rem; height: 3px; border-radius: 2px; background: #ef4444; }
  .duel-copy h1 { margin-block: 1rem 1.7rem; font-size: clamp(3rem, 5.6vw, 5.6rem); font-weight: 800; line-height: 1.02; letter-spacing: -.066em; overflow-wrap: anywhere; }
  .duel-copy h1 span { display: block; color: #c1322e; text-decoration: underline wavy #ed8c74 .04em; text-underline-offset: .11em; }
  .duel-lead { color: #594f49; font-size: clamp(1rem, 1.45vw, 1.18rem); line-height: 1.6; max-width: 45ch; }
  .duel-actions { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1.1rem 1.4rem; margin-top: 1.8rem; }
  .duel-button { display: inline-flex; justify-content: center; align-items: center; gap: .7rem; padding: .85rem 1.25rem; border-radius: .85rem; background: #c7312e; color: white; font-weight: 750; box-shadow: 0 4px 0 #8e201f; }
  .duel-button:hover { background: #af2927; }
  .table-jump { color: #3d3530; font-weight: 700; font-size: .92rem; text-decoration: underline; text-underline-offset: .25rem; }
  .duel-profiles { display: grid; gap: .9rem; padding: .45rem; }
  .duel-profile { padding: clamp(1.1rem, 2vw, 1.7rem); background: white; border: 1px solid #d6cfc7; border-radius: 1.35rem; box-shadow: 0 4px 0 #ded5ca; transform: rotate(1deg); }
  .duel-profile.duel-brand { background: linear-gradient(135deg, #ffe4dc, #fff1df); border-color: #e89076; box-shadow: 0 4px 0 #e9a78d; transform: rotate(-1deg); }
  .duel-profile header { display: flex; align-items: center; gap: .75rem; border-bottom: 1px solid #8d6f592e; padding-bottom: .75rem; }
  .duel-profile h2 { font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.2; font-weight: 800; }
  .duel-profile header p { color: #65564e; font-size: .82rem; margin-top: .15rem; }
  .duel-profile img, .duel-initial { width: 2.35rem; height: 2.35rem; flex: none; }
  .duel-initial { display: grid; place-items: center; background: #f1eae1; border-radius: .65rem; text-transform: uppercase; color: #634d40; font: 800 1.35rem Poppins, sans-serif; }
  .duel-profile ul { display: grid; align-content: start; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .55rem .85rem; padding-top: .85rem; font-size: .82rem; }
  .duel-profile li, .decision-grid li { display: flex; align-items: baseline; gap: .5rem; }
  .duel-profile li::before, .decision-grid li::before { content: ''; width: .36rem; height: .36rem; flex: none; border-radius: 50%; background: #a18d7f; transform: translateY(-.1em); }
  .duel-brand li::before, .decision-grid article:nth-child(2) li::before { background: #d34d3a; }
  .duel-section { padding: clamp(3.25rem, 6.5vw, 6rem) 0; background-color: white; }
  .duel-heading { max-width: 45rem; margin-bottom: clamp(1.6rem, 3vw, 2.75rem); }
  .duel-heading h2, .decision-grid h2 { font-size: clamp(2.05rem, 3.6vw, 3.4rem); font-weight: 800; line-height: 1.12; letter-spacing: -.053em; overflow-wrap: anywhere; }
  .duel-heading h2 span { color: #b8362b; }
  .duel-heading p:not(.duel-label), .decision-grid article > p:not(.duel-label) { color: #655952; margin-top: .9rem; }
  .duel-heading .duel-label { margin-bottom: .8rem; }
  .duel-decision { background: #fff8ef; }
  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem,5vw,5rem); }
  .decision-grid article { padding-block: 1.25rem; border-top: 3px solid #c9bcae; }
  .decision-grid article:nth-child(2) { border-color: #df6550; }
  .decision-grid h2 { margin-top: .75rem; font-size: clamp(1.65rem, 2.8vw, 2.75rem); }
  .decision-grid ul { margin-top: 1.25rem; display: grid; gap: .6rem; }
  .migration-track { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1.5rem; }
  .migration-track li { padding-top: 1rem; border-top: 1px solid #dacdc1; }
  .migration-track .step { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: .78rem; background: #ffe1d3; color: #923326; font: 800 1.25rem Poppins,sans-serif; transform: rotate(-4deg); box-shadow: 0 3px 0 #e5bca9; }
  .migration-track h3 { font-size: 1.17rem; margin-block: 1.1rem .4rem; }
  .migration-track p, .duel-questions p { color: #5b534f; line-height: 1.6; }
  .migration-action { margin-top: 2.5rem; text-align: center; }
  .duel-faq { background: #fffbf6; }
  .faq-grid { display: grid; grid-template-columns: minmax(0,.75fr) minmax(0,1.25fr); gap: clamp(2rem,5vw,5rem); }
  .duel-questions details { border-bottom: 1px solid #dfd4ca; }
  .duel-questions details:first-child { border-top: 1px solid #dfd4ca; }
  .duel-questions summary { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; cursor: pointer; padding: 1.15rem 0; font-weight: 650; }
  .duel-questions summary::after { content: '+'; color: #b5342d; font-size: 1.2rem; }
  .duel-questions details[open] summary::after { content: '−'; }
  .duel-questions summary::-webkit-details-marker { display: none; }
  .duel-questions p { padding-bottom: 1rem; }
  @media (max-width: 49rem) {
    .duel-width { width: min(38rem, calc(100% - 2.5rem)); }
    .duel-grid, .decision-grid, .faq-grid { grid-template-columns: minmax(0,1fr); }
    .duel-copy h1 { font-size: clamp(2.85rem, 10vw, 4.65rem); }
    .migration-track { grid-template-columns: 1fr 1fr; }
    .faq-grid { gap: 0; }
  }
  @media (max-width: 26rem) {
    .duel-profile ul { grid-template-columns: minmax(0,1fr); }
  }
</style>
