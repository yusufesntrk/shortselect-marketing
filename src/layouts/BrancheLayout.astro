---
import FamilyHero from '../components/editorial/FamilyHero.astro';
import FeatureSection from '../components/editorial/FeatureSection.astro';
import MarketingLayout from './MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

interface Props {
  title: string;
  description: string;
  badgeText: string;
  badgeIcon: string;
  headline: string;
  highlightedWord: string;
  headlineSuffix?: string;
  subline: string;
  painBadge?: string;
  painTitle: string;
  painHighlight?: string;
  painPoints: { title: string; description: string; iconPath: string }[];
  featuresBadge?: string;
  featuresTitle: string;
  featuresHighlight?: string;
  features: { title: string; description: string; iconPath: string }[];
  steps?: { step: string; title: string; description: string }[];
  stepsTitle?: string;
  stepsSubline?: string;
}

const {
  title,
  description,
  badgeText,
  badgeIcon,
  headline,
  highlightedWord,
  headlineSuffix = '',
  subline,
  painBadge,
  painTitle,
  painHighlight,
  painPoints,
  featuresBadge = 'Features',
  featuresTitle,
  featuresHighlight,
  features,
  steps,
  stepsTitle,
  stepsSubline,
} = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": "Branchen", "item": "https://www.shortselect.com/branchen/" },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
};
---

<MarketingLayout title={title} description={description} jsonLd={breadcrumbSchema}>
  <FamilyHero
    id="branche-hero" kind="brief" label={badgeText}
    parent={{ label: 'Branchen', href: '/branchen/' }} subline={subline}
    sheetTitle={badgeText} rows={painPoints.map((point, i) => ({ ...point, href: `#branche-painpoints-${i + 1}` }))}
    trial secondary={{ label: 'Features entdecken', href: '#features' }}
  >
    {headline}{' '}<em>{highlightedWord}</em>{/^[.,!?]/.test(headlineSuffix) ? headlineSuffix : ` ${headlineSuffix}`}
    <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={badgeIcon} /></svg>
  </FamilyHero>

  <FeatureSection
    id="branche-painpoints" variant="notes" title={painTitle} accent={painHighlight}
    label={painBadge} items={painPoints}
  />
  {steps && steps.length > 0 && (
    <FeatureSection
      id="branche-steps" variant="steps" title={stepsTitle || "So einfach geht's"}
      intro={stepsSubline} items={steps}
    />
  )}
  <FeatureSection id="features" label={featuresBadge} title={featuresTitle} accent={featuresHighlight} items={features} />
  <slot />
  <CTASection />
</MarketingLayout>
