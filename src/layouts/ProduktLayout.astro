---
import FamilyHero from '../components/editorial/FamilyHero.astro';
import FeatureSection from '../components/editorial/FeatureSection.astro';
import MarketingLayout from './MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

interface Feature {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  badgeText: string;
  heroTitle: string;
  heroHighlight: string;
  heroSuffix?: string;
  heroSubtitle: string;
  heroIcon: string;
  features: Feature[];
  featuresSectionTitle: string;
  featuresSectionSubtitle: string;
  featuresBadge?: string;
}

const {
  title,
  description,
  canonical,
  badgeText,
  heroTitle,
  heroHighlight,
  heroSuffix = '.',
  heroSubtitle,
  heroIcon,
  features,
  featuresSectionTitle,
  featuresSectionSubtitle,
  featuresBadge = 'Features',
} = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": "Produkt", "item": "https://www.shortselect.com/produkt/" },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
};
---

<MarketingLayout title={title} description={description} canonical={canonical} jsonLd={breadcrumbSchema}>
  <FamilyHero
    id="produkt-hero" kind="module" label={badgeText}
    parent={{ label: 'Produkt', href: '/produkt/' }}
    subline={heroSubtitle} sheetTitle={badgeText}
    rows={features.slice(0, 3).map((feature, i) => ({ ...feature, href: `#produkt-features-${i + 1}` }))}
    trial
  >
    {heroTitle}{' '}<em>{heroHighlight}</em>{heroSuffix}
    <Fragment slot="icon" set:html={heroIcon} />
  </FamilyHero>

  <slot name="before-features" />
  <FeatureSection
    id="produkt-features" label={featuresBadge} title={featuresSectionTitle}
    intro={featuresSectionSubtitle} items={features}
  />
  <slot name="after-features" />
  <slot />
  <CTASection />
</MarketingLayout>
