---
import FamilyHero from '../components/editorial/FamilyHero.astro';
import MarketingLayout from './MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

interface HubItem {
  title: string;
  href: string;
  description: string;
}

interface HubFaq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  breadcrumbName: string;
  breadcrumbUrl: string;
  badge: string;
  h1: string;
  heroHighlight?: string;
  heroSuffix?: string;
  heroSubtitle: string;
  introHtml?: string;
  gridBadge: string;
  gridTitle: string;
  gridSubtitle: string;
  items: HubItem[];
  faqs?: HubFaq[];
}

const {
  title,
  description,
  canonical,
  breadcrumbName,
  breadcrumbUrl,
  badge,
  h1,
  heroHighlight,
  heroSuffix = '',
  heroSubtitle,
  introHtml,
  gridBadge,
  gridTitle,
  gridSubtitle,
  items,
  faqs = [],
} = Astro.props;

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description: description,
  url: canonical,
  inLanguage: "de-DE",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: item.title,
      url: `https://www.shortselect.com${item.href}`,
    })),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": breadcrumbName, "item": breadcrumbUrl },
  ],
};

const faqSchema = faqs.length >= 2 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;

const jsonLd = faqSchema
  ? [collectionPageSchema, breadcrumbSchema, faqSchema]
  : [collectionPageSchema, breadcrumbSchema];
---

<MarketingLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <FamilyHero
    kind="directory" label={badge} subline={heroSubtitle}
    sheetTitle={gridTitle} rows={items.slice(0, 4)}
  >
    {h1}{heroHighlight && <> <em>{heroHighlight}</em></>}{heroSuffix}
  </FamilyHero>

  {introHtml && <div class="family-directory__intro prose-hub space-y-4" set:html={introHtml} />}
  <section class="family-section">
    <div class="family-section__inner">
      <header class="family-section__head">
        <p class="family-section__label">{gridBadge}</p>
        <h2>{gridTitle}</h2>
        <p class="family-section__intro">{gridSubtitle}</p>
      </header>
      <div class="family-section__grid">
        {items.map((item) => (
          <a class="family-directory__card" href={item.href}>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span>Mehr erfahren <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="family-section family-section--faq">
      <div class="family-section__inner">
        <header class="family-section__head"><h2>Häufige Fragen</h2></header>
        {faqs.map((faq) => (
          <details class="family-faq">
            <summary>{faq.q}</summary>
            <p set:html={faq.a} />
          </details>
        ))}
      </div>
    </section>
  )}
  <CTASection />
</MarketingLayout>
