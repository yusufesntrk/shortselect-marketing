---
import FamilyHero from '../components/editorial/FamilyHero.astro';
import FeatureSection from '../components/editorial/FeatureSection.astro';
import MarketingLayout from './MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

interface Props {
  title: string;
  description: string;
  badgeText: string;
  badgeIcon: string;
  headline: string;
  highlightedWord: string;
  headlineSuffix?: string;
  subline: string;
  benefits: { title: string; description: string; iconPath: string }[];
  benefitsTitle: string;
  benefitsHighlight?: string;
  howItWorks: { step: string; title: string; description: string }[];
  howItWorksTitle?: string;
  howItWorksSubline?: string;
  trustItems?: string[];
}

const {
  title,
  description,
  badgeText,
  badgeIcon,
  headline,
  highlightedWord,
  headlineSuffix = '',
  subline,
  benefits,
  benefitsTitle,
  benefitsHighlight,
  howItWorks,
  howItWorksTitle = 'So funktioniert die Integration',
  howItWorksSubline,
  trustItems,
} = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shortselect.com/" },
    { "@type": "ListItem", "position": 2, "name": "Integrationen", "item": "https://www.shortselect.com/integrationen/" },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
};
---

<MarketingLayout title={title} description={description} jsonLd={breadcrumbSchema}>
  <FamilyHero
    id="integration-hero" kind="connection" label={badgeText} subline={subline}
    sheetTitle={`${badgeText} und ShortSelect`}
    rows={benefits.slice(0, 3).map((benefit, i) => ({ ...benefit, href: `#benefits-${i + 1}` }))}
    trial secondary={{ label: 'Vorteile entdecken', href: '#benefits' }}
  >
    {headline}{' '}<em>{highlightedWord}</em>{/^[.,!?]/.test(headlineSuffix) ? headlineSuffix : ` ${headlineSuffix}`}
    <svg slot="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={badgeIcon} /></svg>
  </FamilyHero>

  <slot />
  <FeatureSection id="integration-steps" variant="steps" title={howItWorksTitle} intro={howItWorksSubline} items={howItWorks} />
  <FeatureSection id="benefits" title={benefitsTitle} accent={benefitsHighlight} items={benefits} />
  {trustItems && trustItems.length > 0 && (
    <section id="integration-trust" class="family-trust" aria-label="Integration">
      <ul>{trustItems.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
    </section>
  )}
  <CTASection />
</MarketingLayout>
