---
import PageIntro from '../../components/marketing/PageIntro.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import CTASection from '../../components/landing/CTASection.astro';
import { glossaryTerms } from '../../data/glossary';
---

<MarketingLayout
  title="Recruiting Glossar – HR-Begriffe einfach erklärt | ShortSelect"
  description="Die wichtigsten Begriffe aus Recruiting, HR und Bewerbermanagement -- von ATS bis Quality of Hire, einfach und verständlich erklärt."
>
  <!-- Hero -->
  <PageIntro label="Wissen"
    description="Die wichtigsten Begriffe aus Recruiting, HR und Bewerbermanagement, einfach erklärt."
  >
    <Fragment slot="title">Recruiting <em>Glossar</em></Fragment>
    <nav slot="aside" class="index-sheet" aria-label="Begriffe im Glossar">
      <ul>{glossaryTerms.slice(0, 4).map(term => <li><a href={`/glossar/${term.slug}/`}>{term.title}<span aria-hidden="true">→</span></a></li>)}</ul>
    </nav>
  </PageIntro>

  <!-- Terms Grid -->
  <section class="story-section py-20 md:py-28 relative overflow-hidden">
    <div class="absolute top-20 right-0 w-80 h-80 bg-[hsl(var(--accent)/0.05)] rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-0 w-64 h-64 bg-[hsl(var(--primary)/0.05)] rounded-full blur-3xl"></div>

    <div class="container mx-auto px-4">
      <div class="reveal-item opacity-0 translate-y-8 transition-all duration-700 text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-2.5 py-0.5 rounded-full border border-[hsl(var(--primary)/0.2)] text-[hsl(var(--primary))] text-xs font-medium mb-4">A-Z</span>
        <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight mb-4">Alle Begriffe im Überblick</h2>
        <p class="text-lg text-[hsl(var(--muted-foreground))]">Von ATS bis Quality of Hire -- Ihr Nachschlagewerk für modernes Recruiting.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {glossaryTerms.map((term, i) => (
          <a class="reveal-item opacity-0 translate-y-8 transition-all duration-500" style={`transition-delay: ${Math.min(i * 100, 500)}ms;`} href={`/glossar/${term.slug}/`}>
            <article class="sheet-card group h-full rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] hover:shadow-lg hover:border-[hsl(var(--primary)/0.5)] hover:-translate-y-1 transition-all duration-500 cursor-pointer p-6 space-y-4">
              <div class="h-12 w-12 rounded-xl bg-[hsl(var(--primary)/0.1)] flex items-center justify-center group-hover:bg-[hsl(var(--primary)/0.2)] transition-colors">
                <svg class="h-6 w-6 text-[hsl(var(--primary))]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <h3 class="text-lg font-display font-bold group-hover:text-[hsl(var(--primary))] transition-colors">{term.title}</h3>
              <p class="text-sm text-[hsl(var(--muted-foreground))] leading-relaxed">{term.description}</p>
              <div class="flex items-center gap-1 text-sm font-medium text-[hsl(var(--primary))] opacity-0 group-hover:opacity-100 transition-opacity">
                Mehr erfahren
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection />

  <script is:inline>
  (function() {
    var items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    items.forEach(function(item) { observer.observe(item); });
  })();
  </script>
</MarketingLayout>
