              <thead class="bg-muted/40">
                <tr>
                  <th class="text-left p-2 border-b border-muted-foreground/20">Verarbeitung</th>
                  <th class="text-left p-2 border-b border-muted-foreground/20">Daten</th>
                  <th class="text-left p-2 border-b border-muted-foreground/20">Zweck</th>
                  <th class="text-left p-2 border-b border-muted-foreground/20">Rechtsgrundlage und berechtigtes Interesse</th>
                  <th class="text-left p-2 border-b border-muted-foreground/20">Speicherdauer</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="p-2 border-b border-muted-foreground/10 align-top">Registrierung, Einladung, Kontoführung</td>
