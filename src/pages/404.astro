---
import PageIntro from '../components/marketing/PageIntro.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Seite nicht gefunden – ShortSelect"
  description="Die angeforderte Seite existiert nicht. Zurück zur Startseite von ShortSelect."
  noindex={true}
>
  <PageIntro label="404" description="Die Seite, die Sie suchen, existiert nicht oder wurde verschoben.">
    <Fragment slot="title">Seite <em>nicht gefunden</em></Fragment>
    <div class="intro-actions"><a class="paper-button" href="/">Zur Startseite <span aria-hidden="true">→</span></a></div>
  </PageIntro>
</MarketingLayout>
