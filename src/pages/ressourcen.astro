---
import PageIntro from '../components/marketing/PageIntro.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';

const categories = [
  {
    title: "Playbooks",
    description: "Schritt-für-Schritt Anleitungen für die wichtigsten Recruiting-Prozesse.",
    links: [
      { label: "Passive Kandidaten aktivieren", to: "/methode/playbook/passive-kandidaten/" },
      { label: "Der perfekte Nachfass-Workflow", to: "/methode/playbook/bewerber-nachfass/" },
      { label: "Vom Angebot zum ersten Arbeitstag", to: "/methode/playbook/onboarding/" },
    ],
  },
  {
    title: "Smart Recruiting Methode",
    description: "Unsere bewährte Methodik für erfolgreiches, datengetriebenes Recruiting.",
    links: [
      { label: "Methode im Überblick", to: "/methode/" },
      { label: "Smart Recruiting Guide", to: "/methode/smart-recruiting/" },
      { label: "Anziehen", to: "/methode/anziehen/" },
      { label: "Auswählen", to: "/methode/auswaehlen/" },
      { label: "Einstellen", to: "/methode/einstellen/" },
      { label: "Binden", to: "/methode/binden/" },
    ],
  },
  {
    title: "Vergleiche",
    description: "Objektive Vergleiche mit den bekanntesten Recruiting-Plattformen.",
    links: [
      { label: "vs. Personio", to: "/vergleich/shortselect-vs-personio/" },
      { label: "vs. Softgarden", to: "/vergleich/shortselect-vs-softgarden/" },
      { label: "vs. Bullhorn", to: "/vergleich/shortselect-vs-bullhorn/" },
      { label: "vs. Greenhouse", to: "/vergleich/shortselect-vs-greenhouse/" },
      { label: "Beste ATS 2026", to: "/vergleich/beste-ats-software/" },
      { label: "Alle Vergleiche", to: "/vergleich/" },
    ],
  },
  {
    title: "Glossar",
    description: "Die wichtigsten Begriffe aus Recruiting und HR -- einfach erklärt.",
    links: [
      { label: "HR & Recruiting Glossar", to: "/glossar/" },
    ],
  },
];
---

<MarketingLayout
  title="Ressourcen – Playbooks, Guides & Best Practices | ShortSelect"
  description="Playbooks, Smart Recruiting Methode, Vergleiche und Glossar. Alles was Sie brauchen, um Ihr Recruiting auf das nächste Level zu bringen."
>
  <!-- Hero -->
  <PageIntro
    description="Playbooks, Guides und Best Practices, alles was Sie brauchen, um Ihr Recruiting auf das nächste Level zu bringen."
  >
    <Fragment slot="title">Ressourcen für modernes <em>Recruiting</em></Fragment>
    <nav slot="aside" class="index-sheet" aria-label="Ressourcen">
      <ul>{categories.map((category, i) => <li><a href={`#ressource-${i}`}>{category.title}<span aria-hidden="true">↘</span></a></li>)}</ul>
    </nav>
  </PageIntro>

  <!-- Categories Grid -->
  <section class="story-section py-20 md:py-28 relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {categories.map((cat, i) => (
          <div id={`ressource-${i}`} class="sheet-card reveal-item opacity-0 translate-y-8 transition-all duration-500 rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-8 space-y-6" style={`transition-delay: ${i * 100}ms;`}>
            <div>
              <h3 class="text-xl font-display font-bold">{cat.title}</h3>
              <p class="text-sm text-[hsl(var(--muted-foreground))] mt-2">{cat.description}</p>
            </div>
            <ul class="space-y-3">
              {cat.links.map((link) => (
                <li>
                  <a href={link.to} class="flex items-center gap-2 text-sm font-medium hover:text-[hsl(var(--primary))] transition-colors group">
                    <svg class="h-4 w-4 text-[hsl(var(--primary))] transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Blog + Glossar Highlights -->
  <section class="story-section py-20 md:py-28 bg-[hsl(var(--muted)/0.3)]">
    <div class="container mx-auto px-4">
      <div class="reveal-item opacity-0 translate-y-8 transition-all duration-700 text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight mb-4">Mehr entdecken</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a href="/blog/" class="sheet-card reveal-item opacity-0 translate-y-8 transition-all duration-700 rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-8 hover:shadow-lg hover:border-[hsl(var(--primary)/0.2)] transition-all group">
          <h3 class="text-xl font-display font-bold group-hover:text-[hsl(var(--primary))] transition-colors">Blog</h3>
          <p class="text-sm text-[hsl(var(--muted-foreground))] mt-2">Recruiting-Wissen, Praxis-Guides und Trends -- von unserem Team für Ihres.</p>
        </a>
        <a href="/glossar/" class="sheet-card reveal-item opacity-0 translate-y-8 transition-all duration-500 rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-8 hover:shadow-lg hover:border-[hsl(var(--primary)/0.2)] transition-all group" style="transition-delay: 100ms;">
          <h3 class="text-xl font-display font-bold group-hover:text-[hsl(var(--primary))] transition-colors">Glossar</h3>
          <p class="text-sm text-[hsl(var(--muted-foreground))] mt-2">Die wichtigsten HR-Begriffe von ATS bis Quality of Hire, einfach erklärt.</p>
        </a>
      </div>
    </div>
  </section>

  <CTASection />

  <script is:inline>
  (function() {
    var items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    items.forEach(function(item) { observer.observe(item); });
  })();
  </script>
</MarketingLayout>
