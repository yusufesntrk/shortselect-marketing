---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import CTASection from '../components/landing/CTASection.astro';
import { testimonials } from '@/data/testimonials';

// Alle Kundenstimmen kommen aus src/data/testimonials.ts, derselben Quelle wie das
// Kartenband auf der Startseite. Keine zweite Liste mit eigenen Zitaten pflegen.
const formatMetric = (m: (typeof testimonials)[number]['metric']) =>
  `${m.prefix ?? ''}${m.value}${m.suffix ?? ''}`;
---

<MarketingLayout
  title="Kunden & Erfolgsgeschichten – Wer nutzt ShortSelect | ShortSelect"
  description="Erfahren Sie, wie Recruiting-Agenturen und HR-Teams mit ShortSelect ihre Besetzungszeit verkürzen und mehr Placements erzielen."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-28 md:py-40 bg-gradient-to-br from-[hsl(var(--primary))] via-[hsl(var(--primary)/0.95)] to-[hsl(var(--accent))] text-white">
    <div class="absolute top-10 left-[10%] w-72 h-72 bg-white/5 rounded-full blur-3xl animate-float-slow"></div>
    <div class="absolute bottom-10 right-[10%] w-96 h-96 bg-white/5 rounded-full blur-3xl animate-float-slow" style="animation-delay: -3s;"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[size:32px_32px] opacity-40"></div>

    <div class="container relative mx-auto px-4">
      <div class="reveal-item opacity-0 translate-y-8 transition-all duration-700 max-w-3xl mx-auto text-center space-y-6">
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-white/90 border border-white/20 text-sm font-medium">Erfolgsgeschichten</span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight leading-tight">
          Teams, die mit ShortSelect gewinnen.
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto">
          Von der Solo-Agentur bis zum mehrköpfigen Recruiting-Team: So nutzen unsere Kunden ShortSelect.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[hsl(var(--background))] to-transparent"></div>
  </section>

  <!-- Kundenstimmen -->
  <section class="py-20 md:py-28 bg-[hsl(var(--muted)/0.3)] relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="reveal-item opacity-0 translate-y-8 transition-all duration-700 text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight mb-4">Was unsere Kunden sagen</h2>
        <p class="text-lg text-[hsl(var(--muted-foreground))]">Recruiting-Agenturen, Personalberater und Sourcing-Profis, die täglich mit ShortSelect arbeiten.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-7xl mx-auto items-stretch">
        {testimonials.map((t, i) => {
          const isDown = t.metric.direction === 'down';
          const tone = isDown ? 'text-success' : 'text-primary';
          return (
            <article
              class="reveal-item opacity-0 translate-y-8 transition-all duration-500 bg-card rounded-2xl overflow-hidden border border-border/50 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.06)] hover:shadow-xl flex flex-col h-full group"
              style={`transition-delay: ${(i % 3) * 100}ms;`}
            >
              <div class="relative aspect-[4/3] bg-muted overflow-hidden">
                {t.image ? (
                  <img
                    src={t.image}
                    alt={`${t.name}, ${t.company}`}
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    style={`object-position: ${t.imagePosition ?? 'top'};`}
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center">
                    <span class="text-6xl font-display font-bold text-primary/40">
                      {t.name.split(' ').map((n) => n[0]).join('')}
                    </span>
                  </div>
                )}
                <div class="absolute bottom-3 left-3 bg-card/95 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-semibold text-foreground shadow-sm">
                  {t.company}
                </div>
              </div>

              <div class="p-6 flex-1 flex flex-col">
                <blockquote class="text-foreground font-medium leading-relaxed mb-4">
                  &ldquo;{t.quote}&rdquo;
                </blockquote>

                <div class="mt-auto mb-6 pb-6 border-b border-border/50 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    {t.linkedin ? (
                      <a href={t.linkedin} target="_blank" rel="noopener noreferrer" class="font-display font-bold text-foreground hover:text-primary transition-colors">{t.name}</a>
                    ) : (
                      <p class="font-display font-bold text-foreground">{t.name}</p>
                    )}
                    <p class="text-sm text-muted-foreground">{t.role}</p>
                  </div>
                  {t.linkedin && (
                    <a
                      href={t.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`LinkedIn-Profil von ${t.name}`}
                      title="LinkedIn-Profil"
                      class="flex-shrink-0 w-9 h-9 rounded-full border border-border bg-card text-muted-foreground hover:text-[#0A66C2] hover:border-[#0A66C2]/40 hover:bg-[#0A66C2]/5 flex items-center justify-center transition-colors"
                    >
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-4 h-4"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                    </a>
                  )}
                </div>

                <div class="bg-muted/50 rounded-xl p-4">
                  <div class="flex items-center justify-between gap-3 mb-2">
                    <span class="text-sm text-muted-foreground">{t.metric.label}</span>
                    {isDown ? (
                      <svg class="w-4 h-4 text-success flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>
                    ) : (
                      <svg class="w-4 h-4 text-primary flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                    )}
                  </div>
                  <div class="flex items-baseline gap-2 flex-wrap">
                    <span class={`font-display font-bold ${typeof t.metric.value === 'number' ? 'text-4xl leading-none tabular-nums' : 'text-2xl leading-tight'} ${tone}`}>
                      {formatMetric(t.metric)}
                    </span>
                    <span class="text-sm text-muted-foreground">{t.metric.description}</span>
                  </div>
                  <div class="flex items-end gap-1 h-8 mt-4" aria-hidden="true">
                    {Array.from({ length: 8 }).map((_, j) => {
                      const height = isDown ? Math.max(20, 100 - j * 12) : Math.min(100, 25 + j * 10);
                      return <div class={`flex-1 rounded-t ${isDown ? 'bg-success/40' : 'bg-primary/40'}`} style={`height: ${height}%;`}></div>;
                    })}
                  </div>
                </div>

                <ul class="mt-4 space-y-2">
                  {t.results.map((r) => (
                    <li class="flex items-start gap-2 text-sm text-muted-foreground">
                      <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection />

  <script is:inline>
  (function() {
    var items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    items.forEach(function(item) { observer.observe(item); });
  })();
  </script>
</MarketingLayout>
